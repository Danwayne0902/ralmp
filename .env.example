# Copy to .env before `docker compose up --build -d`.
# Real secrets belong in your secret manager, not this file.

APP_ENV=local
APP_DEBUG=true

# Leave empty to generate one on first boot in the shared app_keys volume.
# Generate a production key with `php artisan key:generate --show`.
APP_KEY=

DB_PASSWORD=password

# Redis is used for cache, sessions, carts and queues by the compose stack.
REDIS_PASSWORD=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Marketplace rules
RAMLP_DELIVERY_FEE=2500
RAMLP_DEFAULT_DELIVERY_DAYS=3

# Uploads: local public disk by default; set to s3 for production.
UPLOADS_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_VISIBILITY=private
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend build values (baked in by Vite).
VITE_API_URL=http://localhost:8000/api/v1
VITE_ASSET_URL=

# Requests per minute per user or IP. Set 0 only for a controlled load test.
API_RATE_LIMIT=120
